# Backend environment (copy to backend/.env, or set these in the Vercel project settings)

# Supabase project URL and the *service_role* key (Project Settings -> API).
# This key bypasses Row Level Security. Never put it in the frontend or commit it.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Firebase project id (same as VITE_FIREBASE_PROJECT_ID). Used to verify ID tokens; no secret needed.
FIREBASE_PROJECT_ID=

# Optional
# Browser origins allowed to call the API cross-origin, comma separated. Leave empty for same-origin.
# CORS_ORIGINS=https://your-app.vercel.app
# SHIPPING_PER_FARMER=40   # charged once per farmer in an order
# PORT=5001
