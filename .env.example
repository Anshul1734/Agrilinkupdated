# Frontend environment (copy to .env). These are public by design - they ship in the browser bundle.
# Firebase console -> Project settings -> Your apps -> Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional display settings
# VITE_CURRENCY=INR
# VITE_LOCALE=en-IN

# Optional: shown on the Contact and Privacy pages. Anything left empty is simply not shown.
# VITE_CONTACT_EMAIL=
# VITE_CONTACT_PHONE=
# VITE_CONTACT_ADDRESS=

# Serve a built-in demo catalogue (products, images, reviews) instead of calling the API.
VITE_MOCK=false
